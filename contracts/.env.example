# First key is the deployer. The rehearsal requires at least three funded keys.
SEPOLIA_PRIVATE_KEYS=0xKEY_ONE,0xKEY_TWO,0xKEY_THREE
# PRIVATE_KEY remains supported for deploy-only use when SEPOLIA_PRIVATE_KEYS is unset.
PRIVATE_KEY=
SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=
ZAMA_WRAPPERS_REGISTRY_ADDRESS=0x2f0750Bbb0A246059d80e94c454586a7F27a128e
POOL_DRAW_INTERVAL_SECONDS=3600
# Server-side keeper only. The scheduled workflow writes a JSON report and fails on these alerts.
KEEPER_PRIVATE_KEY=
KEEPER_FUNDING_ENABLED=true
KEEPER_PRIZE_CONFIG_JSON=
KEEPER_MIN_BALANCE_ETH=0.02
KEEPER_STALL_THRESHOLD_MINUTES=20
KEEPER_RPC_MAX_BLOCK_AGE_SECONDS=180
KEEPER_GOLDSKY_URL=https://api.goldsky.com/api/public/project_cmsqxy20s9sno01ulf3j3aoqt/subgraphs/zamops-pool-sepolia/v0.0.3/gn
KEEPER_FAUCET_SPONSOR_ADDRESS=0xd04BBA49865f57840D4F03CCf541961906843AF1
KEEPER_FAUCET_SPONSOR_MIN_BALANCE_ETH=0.02
KEEPER_REPORT_PATH=reports/pool-keeper.json
# Optional one-pool scope for an explicit rehearsal; scheduled production runs leave this unset.
KEEPER_POOL_ADDRESS=
# Optional one-step recovery command. Index 1 keeps the manual proof separate from the keeper signer at index 0.
FALLBACK_SIGNER_INDEX=1
FALLBACK_POOL_ADDRESS=0x2Eeb28cB5fF0C3339163e3779794ac8a19BCD327
# Public address used by the server-side faucet sponsor. Never put its private key in the browser.
FAUCET_RELAYER_ADDRESS=
